print("An Astronomical Unit (AU) is the average distance between the Earth and the Sun.")
print("One AU =", const.au)
print("AU in kilometers:", const.au.to(u.km))



diameter_col = ["Diameter (km)"]
million_km_cols = [
    "Distance from Sun (10^6 km)",
    "Perihelion (10^6 km)",
    "Aphelion (10^6 km)"
]

for col in diameter_col + million_km_cols:
    df[col] = pd.to_numeric(df[col], errors="coerce")

for col in diameter_col:
    df[col] = (df[col] * u.km).to(u.AU).value

for col in million_km_cols:
    df[col] = (df[col] * 1e6 * u.km).to(u.AU).value

df = df.rename(columns={
    "Diameter (km)": "Diameter (AU)",
    "Distance from Sun (10^6 km)": "Distance from Sun (AU)",
    "Perihelion (10^6 km)": "Perihelion (AU)",
    "Aphelion (10^6 km)": "Aphelion (AU)"
})

planet = "Earth"

for col in df.columns:
    if "(AU)" in col:
        print(f"{planet} {col}: {df.loc[planet, col]:.6f} AU")


df.to_csv("units.csv", index=False)
